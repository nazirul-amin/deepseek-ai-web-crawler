GROQ_API_KEY=gsk_123
FORCE_REPROCESS=0
 
# Qdrant local defaults
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=pdn_chatbot
QDRANT_API_KEY=
 
# Embeddings backend for ingestion: ollama or openai
EMBED_BACKEND=ollama

# Ollama embeddings settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text
 
# OpenAI embeddings settings (used when EMBED_BACKEND=openai)
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
# Optional, override base URL (e.g., Azure OpenAI-compatible endpoint)
OPENAI_BASE_URL=

# RAG output directory (records/ and chunks/ live here)
RAG_DIR=data/rag
